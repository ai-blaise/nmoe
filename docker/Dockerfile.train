FROM xjdr/nmoe:deps

WORKDIR /workspace/nmoe

ENV NCCL_DEBUG=WARN
ENV NCCL_NET=Socket
ENV NCCL_IB_DISABLE=1
ENV NCCL_P2P_DISABLE=0
ENV NCCL_P2P_LEVEL=NVL
ENV NCCL_NET_GDR_LEVEL=0
ENV NCCL_NVLS_ENABLE=0
ENV NCCL_SOCKET_IFNAME=eth0
ENV GLOO_SOCKET_IFNAME=eth0
ENV NCCL_SOCKET_NTHREADS=4
ENV NCCL_NSOCKS_PERTHREAD=4
ENV NCCL_BUFFSIZE=16777216
ENV NCCL_MIN_NCHANNELS=4
ENV NCCL_MAX_NCHANNELS=8
ENV NCCL_ALGO=Tree,Ring
ENV NCCL_PROTO=Simple,LL128,LL
ENV NCCL_CROSS_NIC=0
ENV NCCL_SHM_DISABLE=0
ENV TORCH_NCCL_BLOCKING_WAIT=0
ENV TORCH_DISTRIBUTED_DEBUG=OFF
ENV CUDA_DEVICE_MAX_CONNECTIONS=1
ENV NMOE_ZERO2_RS_CHUNK_MB=512


# Copy source
COPY . /workspace/nmoe

# Build kernels
RUN . .venv/bin/activate && make -C nmoe/csrc

# Python path
ENV PYTHONPATH=/workspace/nmoe:/workspace/nmoe/nmoe/csrc:/workspace/nmoe/third_party/flash_attn:/workspace/nmoe/triton/python
